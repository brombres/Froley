library Froley

class RTokenizer : RogueSourceWriter
  METHODS
    method init_object
      class_name = "Tokenizer"

    method write_content
      writeln ...
        @|# Generated by Froley. Will not be overwritten; customize as desired.
         |$include "TokenizerCore.rogue"
         |
         |class Tokenizer : TokenizerCore
         |  METHODS

         # User methods
        local i = 0
        forEach (fn_name in Program.scanner_user_queries)
          if (i > 0) writeln
          writeln "    method $->Int" (fn_name)
          writeln "      return 0"
          ++i
        endForEach
        forEach (fn_name in Program.scanner_user_calls)
          if (Program.scanner_user_queries.contains(fn_name)) nextIteration
          if (i > 0) writeln
          writeln "    method $" (fn_name)
          writeln "      noAction"
          ++i
        endForEach

      writeln ...
        @|endClass
endClass
