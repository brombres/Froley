library Froley

class RParser : RogueSourceWriter
  METHODS
    method init_object
      class_name = "Parser"

    method write_content
      writeln ...
        @|# Generated by Froley. Will not be overwritten; customize as desired.
         |$include "ParserCore.rogue"
         |
         |class Parser : ParserCore
         |  METHODS

      # User methods
      local i = 0
      forEach (fn_name in Program.parser_user_queries)
        if (i > 0) writeln
        writeln "    method $->Int" (fn_name)
        writeln "      return 0"
        ++i
      endForEach
      forEach (fn_name in Program.parser_user_calls)
        if (Program.parser_user_queries.contains(fn_name)) nextIteration
        if (i > 0) writeln
        writeln "    method $" (fn_name)
        writeln "      noAction"
        ++i
      endForEach

      writeln ...
        @|endClass
endClass

